{
	"name": "node-rest-server",
	"version": "5.0.0",
	"description": "Configurable node rest server",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.mjs",
			"require": "./lib/index.cjs",
			"default": "./lib/index.mjs"
		}
	},
	"types": "./lib/index.d.ts",
	"type": "module",
	"main": "./lib/index.cjs",
	"module": "./lib/index.mjs",
	"scripts": {
		"start": "concurrently npm:dev:*",
		"start:example": "npm --prefix ./examples start",
		"local": "",
		"build": "vite build",
		"dev:watch": "vite build --watch",
		"dev:server": "tsx dev/index.ts",
		"lint": "npm run lint:check -- --fix",
		"lint:check": "eslint .",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"pre:commit": "lint-staged",
		"prepare": "husky && npm --prefix ./examples install",
		"everything": " npm run build && npm run test:coverage && npm run lint && npm run format",
		"test": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"lint-staged": {
		"src/**/*": [
			"npm run format",
			"npm run lint"
		]
	},
	"repository": {
		"type": "git",
		"url": "git@github.com:nishant-labs/node-rest-server.git"
	},
	"files": [
		"lib"
	],
	"keywords": [
		"node rest",
		"rest-server",
		"express rest wrapper",
		"configuration only rest server"
	],
	"author": "Nishant Kumar Sinha",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/nishant-labs/node-rest-server/issues"
	},
	"homepage": "https://github.com/nishant-labs/node-rest-server#readme",
	"dependencies": {
		"chalk": "5.6.2",
		"cors": "2.8.5",
		"date-fns": "4.1.0",
		"errorhandler": "1.5.1",
		"express": "5.1.0",
		"fastest-validator": "1.19.1",
		"pino": "9.11.0",
		"pino-http": "10.5.0",
		"pino-pretty": "13.1.1"
	},
	"devDependencies": {
		"@eslint/js": "9.36.0",
		"@types/cors": "2.8.19",
		"@types/errorhandler": "1.5.3",
		"@types/express": "5.0.3",
		"@types/node": "24.5.2",
		"@vitest/coverage-v8": "3.2.4",
		"concurrently": "9.2.1",
		"eslint": "9.36.0",
		"husky": "9.1.7",
		"lint-staged": "16.1.6",
		"pactum": "3.8.0",
		"prettier": "3.6.2",
		"tsx": "4.20.5",
		"typescript": "5.9.2",
		"typescript-eslint": "8.44.0",
		"vite": "7.1.6",
		"vite-plugin-dts": "4.5.4",
		"vitest": "3.2.4"
	}
}
